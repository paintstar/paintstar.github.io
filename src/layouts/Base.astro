---
import { site } from '../site.mjs';
import { url } from '../lib/posts';
import Icon from '../components/Icon.astro';
import Search from '../components/Search.astro';
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  date?: Date;
  updated?: Date;
}
const { title, description = site.description, article = false, date, updated } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { title: '文章', path: '' },
  { title: '项目', path: 'projects/' },
  { title: '归档', path: 'archives/' },
  { title: '关于', path: 'about/' },
];
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const schema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: date?.toISOString(),
      dateModified: (updated ?? date)?.toISOString(),
      url: canonical.href,
      author: { '@type': 'Person', name: site.author, url: site.github },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: site.name,
      url: site.url,
      description,
    };
---

<!doctype html>
<html lang={site.language} data-theme={site.defaultTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f9f5" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={url('rss.xml')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary" />
    {date && <meta property="article:published_time" content={date.toISOString()} />}
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />
    <script is:inline define:vars={{ defaultTheme: site.defaultTheme }}>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('shin-theme');
        } catch {}
        document.documentElement.dataset.theme = ['light', 'dark', 'sage'].includes(theme)
          ? theme
          : defaultTheme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳到正文
    </a>
    <header class="site-header shell">
      <a class="brand" href={url()} aria-label={`${site.name} 首页`}>
        <span class="brand-mark">
          s<span>.</span>
        </span>
        <span class="brand-name">
          {site.author}
          <span class="brand-slash"> / </span>
          <span class="brand-notes">notes</span>
        </span>
      </a>
      <nav aria-label="主导航">
        {nav.map((item) => (
          <a
            href={url(item.path)}
            class:list={{
              active: path === url(item.path) || (item.path && path.startsWith(url(item.path))),
            }}
            aria-current={path === url(item.path) ? 'page' : undefined}
          >
            {item.title}
          </a>
        ))}
      </nav>
      <div class="header-actions">
        <button id="open-search" class="icon-button search-trigger" aria-label="搜索文章">
          <Icon name="search" />
          <kbd>⌘ K</kbd>
        </button>
        <span class="action-divider"></span>
        <details class="theme-picker" id="theme-picker">
          <summary class="icon-button" aria-label="选择主题" title="选择主题">
            <Icon name="sun" />
          </summary>
          <div class="theme-menu" role="group" aria-label="选择主题">
            <button data-theme-option="dark" aria-pressed="false">
              <span class="theme-swatch swatch-dark"></span>GitHub 深色
            </button>
            <button data-theme-option="light" aria-pressed="false">
              <span class="theme-swatch swatch-light"></span>浅色
            </button>
            <button data-theme-option="sage" aria-pressed="false">
              <span class="theme-swatch swatch-sage"></span>森绿
            </button>
          </div>
        </details>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer shell">
      <div>
        <a class="footer-name" href={url()}>
          {site.author}
          <span>.</span>
        </a>
        <p>{site.name}</p>
      </div>
      <div class="footer-links">
        <a href={site.github} target="_blank" rel="noopener noreferrer">
          GitHub <Icon name="arrow" />
        </a>
        <a href={url('rss.xml')}>
          RSS <Icon name="rss" />
        </a>
        <a href={url('link/')}>友链</a>
        <a href={url('shuoshuo/')}>随记</a>
      </div>
      <p class="footer-copy mono">
        © {new Date().getUTCFullYear()} {site.author}
      </p>
    </footer>
    <Search />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
