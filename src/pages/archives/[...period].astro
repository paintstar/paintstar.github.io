---
import Archive from '../../components/Archive.astro';
import { allPosts, dateLabel } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await allPosts();
  const periods = new Set(
    posts.flatMap((post) => [
      dateLabel(post.data.date).slice(0, 4),
      dateLabel(post.data.date).slice(0, 7).replace('-', '/'),
    ]),
  );
  return [...periods].map((period) => ({
    params: { period },
    props: {
      posts: posts.filter((post) =>
        dateLabel(post.data.date).replaceAll('-', '/').startsWith(period),
      ),
      period,
    },
  }));
}
const { posts, period } = Astro.props;
---

<Archive posts={posts} title={`${period.replace('/', ' / ')} 的笔记`} />
