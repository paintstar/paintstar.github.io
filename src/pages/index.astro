---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import Icon from '../components/Icon.astro';
import Rotation from '../components/Rotation.astro';
import { allPosts, dateLabel, postUrl, readingTime, url } from '../lib/posts';
import { site } from '../site.mjs';
const posts = await allPosts();
const featured = posts.find((post) => post.data.featured);
const topics = [...new Set(posts.map((post) => post.data.topic))].sort(
  (a, b) => site.topics.indexOf(a) - site.topics.indexOf(b),
);
---

<Base title="文章">
  <div class="shell">
    <header class="home-heading">
      <h1>文章</h1>
      <div class="home-stats mono">
        <a href="#notes">{posts.length} 篇文章</a>
      </div>
    </header>
    {featured && (
      <section class="featured-section" aria-labelledby="featured-title">
        <div class="section-caption">
          <span class="eyebrow">FEATURED ARTICLE</span>
          <span class="caption-rule"></span>
        </div>
        <a class="featured-card" href={postUrl(featured)}>
          <div class="featured-copy">
            <div class="post-meta">
              <span class="topic-label">{featured.data.topic}</span>
              <span class="meta-separator">/</span>
              <span>精选文章</span>
            </div>
            <h2 id="featured-title">{featured.data.title}</h2>
            <p>{featured.data.description}</p>
            <div class="featured-bottom">
              <span class="mono">
                {dateLabel(featured.data.date)} · {readingTime(featured)} MIN READ
              </span>
              <span class="featured-arrow">
                <Icon name="arrow" />
              </span>
            </div>
          </div>
          <div class="featured-visual">
            <Rotation />
          </div>
        </a>
      </section>
    )}
    <section id="notes" class="notes-section" aria-labelledby="notes-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">ARTICLES</p>
          <h2 id="notes-title">
            文章<span class="article-count mono">{String(posts.length).padStart(2, '0')}</span>
          </h2>
        </div>
        <a class="text-link muted" href={url('archives/')}>
          全部文章 <Icon name="arrow" />
        </a>
      </div>
      <div class="topic-filters" aria-label="按主题筛选">
        <button data-filter="all" aria-pressed="true">
          全部
        </button>
        {topics.map((topic) => (
          <button data-filter={topic} aria-pressed="false">
            {topic}
          </button>
        ))}
      </div>
      <PostList posts={posts.slice(0, site.homePostCount)} filterable />
      <p id="filter-empty" class="empty-note" hidden>
        最近的文章中暂无这个主题，<a href={url('archives/')}>查看全部文章</a>。
      </p>
      <a class="archive-cta" href={url('archives/')}>
        <span>{posts.length} 篇文章</span>
        <span class="text-link">
          浏览归档 <Icon name="arrow" />
        </span>
      </a>
    </section>
  </div>
</Base>
