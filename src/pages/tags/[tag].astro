---
import Archive from '../../components/Archive.astro';
import { allPosts } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await allPosts();
  return [...new Set(posts.flatMap((post) => post.data.tags))].map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}
const { tag, posts } = Astro.props;
---

<Archive posts={posts} title={`# ${tag}`} description="关于这个关键词的一些思考。" />
