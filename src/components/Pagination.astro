---
import { pageUrl, type PostPage } from '../lib/pagination';
interface Props {
  page: PostPage;
}
const { page } = Astro.props;
const numbers = Array.from({ length: page.pageCount }, (_, index) => index + 1).filter(
  (number) => number === 1 || number === page.pageCount || Math.abs(number - page.currentPage) <= 1,
);
---

{page.pageCount > 1 && (
  <nav class="pagination" aria-label="文章分页">
    <p class="pagination-status">
      共 {page.total} 篇 · 第 <span class="mono">{page.currentPage} / {page.pageCount}</span> 页
    </p>
    <div class="pagination-links">
      {page.currentPage > 1 ? (
        <a class="pagination-step" href={pageUrl(page.basePath, page.currentPage - 1)} rel="prev">上一页</a>
      ) : <span class="pagination-step disabled" aria-disabled="true">上一页</span>}
      {numbers.map((number, index) => (
        <>
          {index > 0 && number - numbers[index - 1] > 1 && <span class="pagination-gap">…</span>}
          <a
            class="pagination-number mono"
            href={pageUrl(page.basePath, number)}
            aria-label={`第 ${number} 页`}
            aria-current={number === page.currentPage ? 'page' : undefined}
          >{number}</a>
        </>
      ))}
      {page.currentPage < page.pageCount ? (
        <a class="pagination-step" href={pageUrl(page.basePath, page.currentPage + 1)} rel="next">下一页</a>
      ) : <span class="pagination-step disabled" aria-disabled="true">下一页</span>}
    </div>
  </nav>
)}
