---
import Base from '../layouts/Base.astro';
import ArticleBrowser from './ArticleBrowser.astro';
import CollectionTrail from './CollectionTrail.astro';
import { url } from '../lib/posts';
import { type PostPage } from '../lib/pagination';
interface Props {
  page: PostPage;
  title?: string;
  description?: string;
  category?: string;
}
const { page, title = '文章归档', description, category } = Astro.props;
const parent = page.basePath.startsWith('tags/')
  ? { title: '标签', path: 'tags/' }
  : page.basePath.startsWith('categories/')
    ? { title: '分类', path: 'categories/' }
    : page.basePath === 'archives/' ? undefined : { title: '归档', path: 'archives/' };
---

<Base title={`${title}${page.currentPage > 1 ? ` · 第 ${page.currentPage} 页` : ''}`}>
  <div class="shell page-shell">
    <CollectionTrail title={title} parent={parent} />
    <header class="page-heading">
      <p class="eyebrow">THE NOTEBOOK / ARCHIVE</p>
      <h1 data-browser-heading>
        <span data-browser-title>{title}</span>
        <span class="article-count mono" data-browser-count>{page.total}</span>
      </h1>
      {description && <p>{description}</p>}
      <div class="archive-tools">
        <a href={url('archives/')} data-browser-reset>全部文章</a>
        <a href={url('tags/')}>按标签</a>
        <a href={url('categories/')}>按分类</a>
      </div>
    </header>
    <ArticleBrowser page={page} groupByYear current={category} title={title} />
  </div>
</Base>
