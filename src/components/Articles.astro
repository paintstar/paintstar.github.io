---
import Base from '../layouts/Base.astro';
import PostList from './PostList.astro';
import Icon from './Icon.astro';
import Rotation from './Rotation.astro';
import { dateLabel, postUrl, readingTime, url, type Post } from '../lib/posts';
import Pagination from './Pagination.astro';
import TopicNav from './TopicNav.astro';
import { type PostPage } from '../lib/pagination';
interface Props { page: PostPage; featured?: Post; }
const { page, featured } = Astro.props;
---

<Base title={`文章${page.currentPage > 1 ? ` · 第 ${page.currentPage} 页` : ''}`}>
  <div class="shell">
    <header class="home-heading">
      <h1>文章</h1>
      <div class="home-stats mono">
        <a href="#notes">{page.total} 篇文章</a>
      </div>
    </header>
    {featured && (
      <section class="featured-section" aria-labelledby="featured-title">
        <div class="section-caption">
          <span class="eyebrow">FEATURED ARTICLE</span>
          <span class="caption-rule"></span>
        </div>
        <a class="featured-card" href={postUrl(featured)}>
          <div class="featured-copy">
            <div class="post-meta">
              <span class="topic-label">{featured.data.topic}</span>
              <span class="meta-separator">/</span>
              <span>精选文章</span>
            </div>
            <h2 id="featured-title">{featured.data.title}</h2>
            <p>{featured.data.description}</p>
            <div class="featured-bottom">
              <span class="mono">
                {dateLabel(featured.data.date)} · {readingTime(featured)} MIN READ
              </span>
              <span class="featured-arrow">
                <Icon name="arrow" />
              </span>
            </div>
          </div>
          <div class="featured-visual">
            <Rotation />
          </div>
        </a>
      </section>
    )}
    <section id="notes" class="notes-section" aria-labelledby="notes-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">ARTICLES</p>
          <h2 id="notes-title">
            文章<span class="article-count mono">{String(page.total).padStart(2, '0')}</span>
          </h2>
        </div>
        <a class="text-link muted" href={url('archives/')}>
          全部文章 <Icon name="arrow" />
        </a>
      </div>
      <TopicNav />
      <PostList posts={page.posts} startIndex={page.startIndex} />
      <Pagination page={page} />
      <a class="archive-cta" href={url('archives/')}>
        <span>{page.total} 篇文章</span>
        <span class="text-link">
          浏览归档 <Icon name="arrow" />
        </span>
      </a>
    </section>
  </div>
</Base>
