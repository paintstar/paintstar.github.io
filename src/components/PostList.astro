---
import { categoryUrl, dateLabel, postCategories, postUrl, readingTime, type Post } from '../lib/posts';
import { site } from '../site.mjs';
import Icon from './Icon.astro';
interface Props {
  posts: Post[];
  startIndex?: number;
  interactive?: boolean;
  currentPage?: number;
}
const { posts, startIndex = 0, interactive = false, currentPage = 1 } = Astro.props;
---

<div class="post-list">
  {posts.map((post, index) => (
    <article
      class="post-row"
      data-topic={interactive ? post.data.topic : undefined}
      data-categories={interactive ? JSON.stringify(postCategories(post)) : undefined}
      hidden={interactive && Math.floor((startIndex + index) / site.pageSize) + 1 !== currentPage}
    >
      <span class="post-number mono" aria-hidden="true">
        {String(startIndex + index + 1).padStart(2, '0')}
      </span>
      <div class="post-summary">
        <div class="post-meta">
          <a class="topic-label" href={categoryUrl(post.data.topic)} data-topic-filter={interactive ? post.data.topic : undefined}>{post.data.topic}</a>
          <span class="meta-separator">/</span>
          <time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time>
        </div>
        <h3>
          <a href={postUrl(post)}>{post.data.title}</a>
        </h3>
        <p>{post.data.description}</p>
        <div class="row-bottom">
          <span>{post.data.tags.slice(0, 3).join(' · ')}</span>
          <span>{readingTime(post)} 分钟阅读</span>
        </div>
      </div>
      <a
        class="row-arrow"
        href={postUrl(post)}
        aria-label={`阅读：${post.data.title}`}
        tabindex="-1"
      >
        <Icon name="arrow" />
      </a>
    </article>
  ))}
</div>
